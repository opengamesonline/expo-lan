{
  "name": "expo-lan-sockets-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@opengamesonline/expo-lan-multiplayer": "file:../../../expo-lan-multiplayer",
    "@opengamesonline/expo-lan-sockets": "file:../..",
    "expo": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --lan",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "check": "tsc --noEmit",
    "test:android:sockets": "android/gradlew -p android :opengamesonline-expo-lan-sockets:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.opengamesonline.expolansockets.TcpManagerInstrumentedTest",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true
